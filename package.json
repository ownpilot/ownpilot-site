{
  "name": "ownpilot-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.12.0 <27"
  },
  "packageManager": "npm@12.2.0",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "preview": "node scripts/preview.mjs",
    "check:export": "node scripts/check-export.mjs",
    "check:links": "node scripts/check-external-links.mjs",
    "test": "playwright test",
    "assets": "node scripts/generate-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "7.0.2"
  }
}
